# 命名规范守卫：readability-identifier-naming（只启这一项，其余检查全部关闭）。
# 口径取自 §4.8.1：类型大驼峰；函数（全局与成员）大驼峰；类成员 m_ + 小驼峰；
# 结构体/联合体成员与局部变量、参数小驼峰（无前缀）；全局变量 g_ + 小驼峰；
# 枚举值与常量全大写。
#
# 两种成员按规范分开检查：
#   PrivateMember/ProtectedMember -> m_ + camelBack（类成员）
#   PublicMember                 -> camelBack（结构体与类的公开数据字段，无前缀）
#
# 有意保留小写的白名单（写进 IgnoredRegexp）：
#   1. Qt 虚函数覆盖与 Qt 惯例枚举值 Type/UserType；
#   2. 与同名类型冲突的成员函数（canvasScene、shapeType、fillStyle 等）；
#   3. Qt 信号（signals 段，moc 生成实现），按 Qt 惯例小写；
#   4. 命名空间自由函数中与类型同名的 curveParamState / lineArtPreset；
#   5. 类内大驼峰常量 BackgroundLayerId（其余 constexpr 全大写）。
#
# 运行方式（Windows + MinGW + Qt Creator 自带 clang-tidy）：
#   MINGW=D:/Qt/Tools/mingw1510_64
#   GCC=$MINGW/lib/gcc/x86_64-w64-mingw32/15.1.0
#   clang-tidy -p build --config-file=.clang-tidy \
#     --extra-arg=--target=x86_64-w64-windows-gnu \
#     --extra-arg=-isystem$GCC/include/c++ \
#     --extra-arg=-isystem$GCC/include/c++/x86_64-w64-mingw32 \
#     --extra-arg=-isystem$GCC/include/c++/backward \
#     --extra-arg=-isystem$MINGW/x86_64-w64-mingw32/include \
#     --extra-arg=-D__GCC_ATOMIC_BOOL_LOCK_FREE=2 \
#     --extra-arg=-D__GCC_ATOMIC_CHAR_LOCK_FREE=2 \
#     --extra-arg=-D__GCC_ATOMIC_CHAR16_T_LOCK_FREE=2 \
#     --extra-arg=-D__GCC_ATOMIC_CHAR32_T_LOCK_FREE=2 \
#     --extra-arg=-D__GCC_ATOMIC_WCHAR_T_LOCK_FREE=2 \
#     --extra-arg=-D__GCC_ATOMIC_SHORT_LOCK_FREE=2 \
#     --extra-arg=-D__GCC_ATOMIC_INT_LOCK_FREE=2 \
#     --extra-arg=-D__GCC_ATOMIC_LONG_LOCK_FREE=2 \
#     --extra-arg=-D__GCC_ATOMIC_LLONG_LOCK_FREE=2 \
#     --extra-arg=-D__GCC_ATOMIC_POINTER_LOCK_FREE=2 \
#     --extra-arg=-D__GCC_ATOMIC_TEST_AND_SET_TRUEVAL=1 \
#     src/CanvasItem.cpp
# 说明：clang 不能直接解析 GCC 15 的 libstdc++（缺内置 intrinsic 头与原子宏），
# 所以只把 libstdc++ 与 win32 头按 -isystem 传入，并补 __GCC_ATOMIC_* 宏与
# windows-gnu target。加 --fix 可自动改名；必须逐个 TU 串行，多进程并行会同时
# 写同一头文件造成错位替换。
Checks: '-*,readability-identifier-naming'
WarningsAsErrors: ''
HeaderFilterRegex: '.*src.*'
SystemHeaders: false
CheckOptions:
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.EnumConstantIgnoredRegexp
    value: '^(Type|UserType)$'
  - key: readability-identifier-naming.FunctionCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionIgnoredRegexp
    value: '^(curveParamState|lineArtPreset)$'
  - key: readability-identifier-naming.MethodCase
    value: CamelCase
  - key: readability-identifier-naming.MethodIgnoredRegexp
    value: '^(accept|fillStyle|activeLayerChanged|arrowEndChosen|arrowStartChosen|axesChosen|backgroundChanged|borderStyleChosen|borderWidthChosen|borderWidthPicked|boundingRect|brushColorChosen|canvasBackground|canvasColorChosen|canvasScene|canvasSizeChanged|chooseFillImageClicked|clearFillImageClicked|closeEvent|contentChanged|contextMenuEvent|cornerRadiusChosen|dragEnterEvent|drawBackground|drawForeground|dropEvent|eventFilter|fillColorChosen|fillImageModeChosen|fillStyleChosen|focusOutEvent|fontChanged|geometryChosen|geometryState|heightAdjusted|heightChosen|hoverLeaveEvent|hoverMoveEvent|id|itemChange|itemPropertiesRequested|keyPressEvent|keyReleaseEvent|layer|layerAdjusted|layerChosen|layerChanged|layerPanel|layersChanged|leaveEvent|lockToggled|mergeWith|mode|modeChanged|mouseDoubleClickEvent|mouseMoveEvent|mousePressEvent|mouseReleaseEvent|nameChosen|opacityChosen|openFolderRequested|options|paint|paintEvent|parallelogramAngleChosen|params|paramState|propertiesPanel|redo|refreshRequested|renameRequested|rotationChosen|groupOperationFailed|shape|shapeLayer|shapeType|showEvent|sineAmplitudeChosen|sineCyclesChosen|startAngleChosen|statusMessage|strokeColorChosen|strokeColorPicked|strokePattern|sweepAngleChosen|textChosen|textColorChosen|textContentChosen|textFontChosen|textPlacementRequested|triangleAngle1Chosen|triangleAngle2Chosen|triangleBaseChosen|triangleVertex|type|undo|valueChosen|valuesChosen|visibilityToggled|wheelEvent|zoomChanged)$'
  - key: readability-identifier-naming.PrivateMemberCase
    value: camelBack
  - key: readability-identifier-naming.PrivateMemberPrefix
    value: 'm_'
  - key: readability-identifier-naming.ProtectedMemberCase
    value: camelBack
  - key: readability-identifier-naming.ProtectedMemberPrefix
    value: 'm_'
  - key: readability-identifier-naming.PublicMemberCase
    value: camelBack
  - key: readability-identifier-naming.LocalVariableCase
    value: camelBack
  - key: readability-identifier-naming.ParameterCase
    value: camelBack
  - key: readability-identifier-naming.ConstexprVariableCase
    value: UPPER_CASE
  - key: readability-identifier-naming.ConstexprVariableIgnoredRegexp
    value: '^BackgroundLayerId$'
  - key: readability-identifier-naming.StaticConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.GlobalConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.GlobalVariableCase
    value: camelBack
  - key: readability-identifier-naming.GlobalVariablePrefix
    value: 'g_'
